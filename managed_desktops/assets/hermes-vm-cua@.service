[Unit]
Description=Cua driver for Hermes managed desktop screen %i
Requires=hermes-vm-desktop@%i.service
After=hermes-vm-desktop@%i.service
PartOf=hermes-vm-desktop@%i.service

[Service]
Type=exec
User=agent
Group=agent
Environment=HOME=/home/agent
Environment=CUA_DRIVER_RS_TELEMETRY_ENABLED=0
UMask=0077
ExecStart=/usr/local/bin/hermes-vm-screen %i /opt/hermes-desktop-vm/cua/cua-driver serve --socket /run/hermes-vm-desktop-%i/cua.sock --permission-mode @PERMISSION_MODE@
ExecStartPost=/usr/local/lib/hermes-desktop-vm/ready.py cua %i
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
