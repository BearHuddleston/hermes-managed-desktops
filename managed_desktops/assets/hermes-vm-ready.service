[Unit]
Description=Verify both managed desktops before publishing readiness
Requires=hermes-vm-desktop@1.service hermes-vm-desktop@2.service hermes-vm-cua@1.service hermes-vm-cua@2.service hermes-vm-view@1.service hermes-vm-view@2.service
After=cloud-config.service hermes-vm-desktop@1.service hermes-vm-desktop@2.service hermes-vm-cua@1.service hermes-vm-cua@2.service hermes-vm-view@1.service hermes-vm-view@2.service

[Service]
User=agent
Group=agent
StateDirectory=hermes-desktop-vm
StateDirectoryMode=0755
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/hermes-desktop-vm/ready.py all
ExecStop=/usr/bin/rm -f /var/lib/hermes-desktop-vm/ready
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
