#!/bin/bash
set -euo pipefail
[[ "${1:-}" =~ ^[12]$ ]] || { printf 'Screen must be 1 or 2\n' >&2; exit 2; }
# D-Bus children must not notify systemd before the display environment exists.
notify_socket="${NOTIFY_SOCKET:?systemd notification socket required}"
exec /usr/bin/env -i HOME=/home/agent USER=agent LOGNAME=agent \
    PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 \
    /usr/bin/dbus-run-session -- /usr/local/lib/hermes-desktop-vm/desktop-session "$1" "$notify_socket"
